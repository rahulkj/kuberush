export HARBOR_REGISTRY_URL="$(keyring get /harbor/url -r)"
export HARBOR_PROJECT=public
export HARBOR_USERNAME="$(keyring get /harbor/credentials -f username -r)"
export HARBOR_PASSWORD="$(keyring get /harbor/credentials -f password -r)"

export HARBOR_PLAIN_HTTP=false
export HARBOR_INSECURE=false

export IMAGE_NAME="kuberush"
export SITE_NAME="kuberush"
export DOMAIN_NAME="k8s.lab.int"
export DEPLOY_PAT=""

export DEPLOY_PAT="$(keyring get /github/push_credentials -f password -r)"
